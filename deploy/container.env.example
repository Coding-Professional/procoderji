# Copy to deploy/container.env. This example contains no credentials.
# Next.js runs separately; its server-only DOTNET_API_URL is http://localhost:5100.
PUBLIC_ORIGIN=http://localhost:3000
API_PORT=5100
# Local HTTP is allowed only in Development. A deployed API must use Production
# and set PUBLIC_ORIGIN to the exact HTTPS frontend origin.
API_ENVIRONMENT=Development

# Set a random password for the ONE selected database. Use letters, digits, _ and -
# here so it can be used unescaped in both connection strings and a MongoDB URI.
POSTGRES_PASSWORD=
MSSQL_SA_PASSWORD=
MONGO_PASSWORD=

# SQL Server only: review its license, then set Y. Developer is for development/test.
MSSQL_ACCEPT_EULA=
MSSQL_PID=Developer

# Optional Google OAuth credentials. Keep the callback on PUBLIC_ORIGIN:
# <PUBLIC_ORIGIN>/api/platform/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# For the base compose.yml with an EXTERNAL database, instead of a DB override:
DATABASE_PROVIDER=Postgres
DATABASE_NAME=procoderji
PLATFORM_CONNECTION_STRING=
