# Copy to deploy/neon.env and replace placeholders with Neon .NET connection details.
# Production template: PublicOrigin must be the exact HTTPS frontend origin.
PUBLIC_ORIGIN=https://procoderji.com
API_PORT=5100
API_ENVIRONMENT=Production

# Runtime: pooled Neon hostname. The pool size is an initial per-process limit to tune.
NEON_RUNTIME_CONNECTION_STRING=Host=ep-your-project-pooler.REGION.aws.neon.tech;Database=neondb;Username=YOUR_ROLE;Password=YOUR_PASSWORD;SSL Mode=VerifyFull;Channel Binding=Require;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=10;No Reset On Close=true;Timeout=30

# Migrations: direct hostname, with the same Neon branch/database; not the pooler.
NEON_MIGRATION_CONNECTION_STRING=Host=ep-your-project.REGION.aws.neon.tech;Database=neondb;Username=YOUR_MIGRATION_ROLE;Password=YOUR_MIGRATION_PASSWORD;SSL Mode=VerifyFull;Channel Binding=Require;Pooling=false;Timeout=30

# Google callback: https://procoderji.com/api/platform/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
